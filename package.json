{
  "name": "@voltti/hermes-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the Hermes Agent documentation, indexed from the local install so answers match the installed version.",
  "type": "module",
  "bin": {
    "hermes-docs-mcp": "dist/cli.js"
  },
